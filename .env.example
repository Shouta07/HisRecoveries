# ── Site ───────────────────────────────────────────────
# Production origin (no trailing slash). Used for canonical URLs, OGP, sitemap.
NEXT_PUBLIC_SITE_URL=https://hisrecoveries.com

# ── Analytics (all optional) ───────────────────────────
# Set whichever provider you use. If none is set, no analytics script
# loads — local/dev builds stay clean.

# Google Analytics 4 — measurement ID (G-XXXXXXXXXX)
# Conversion events fired: gathering_apply / affiliate_click /
# subscribe_click / reflect_complete. First-touch UTM is attached
# automatically, so Threads → CV is attributable.
NEXT_PUBLIC_GA_ID=

# Plausible — the domain you registered (e.g. hisrecoveries.com)
# Uses the tagged-events script; the same conversion events are sent
# as custom goals.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
