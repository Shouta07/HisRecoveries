# ── Site ───────────────────────────────────────────────
# Production origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://hisrecoveries.com

# ── Analytics (all optional) ───────────────────────────
# GA4 measurement ID (G-XXXXXXXXXX). Conversion events fire to gtag.
NEXT_PUBLIC_GA_ID=

# Plausible domain (e.g. hisrecoveries.com). Same events fire as goals.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Supabase (Insight Database) ────────────────────────
# Set up by running supabase/schema.sql once in your Supabase project.
#   1) Create a project on supabase.com
#   2) Run the SQL in supabase/schema.sql via the SQL Editor
#   3) Copy URL + anon key + service key from Project Settings → API
#
# Without these set, forms still work in the browser (localStorage only)
# but no data is persisted server-side and /admin/insights shows a
# setup notice.

# Project URL — https://xxxxx.supabase.co
SUPABASE_URL=
# Public anon key — used by API routes to INSERT (anonymous form posts).
SUPABASE_ANON_KEY=
# Service role key — server-only, used by /admin/insights to SELECT.
# NEVER expose this to the client. It must NOT start with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=

# ── Admin Dashboard ────────────────────────────────────
# /admin/insights is HTTP Basic Auth protected.
# Browser will prompt: Username "admin" / Password is the value below.
ADMIN_PASSWORD=

# ── Stripe (決済) ──────────────────────────────────────
# 設計と運用手順は docs/PAYMENTS_SECURITY.md を参照。
#
# 重要：ここにある値は絶対に NEXT_PUBLIC_ を付けない。
# 付けた瞬間にブラウザのJSに埋め込まれ、鍵が公開される。
# （src/lib/stripe.ts に、付いていたら起動時に落とす検査を入れてある）

# シークレットキー。テストは sk_test_、本番は sk_live_。
# Dashboard → 開発者 → APIキー
STRIPE_SECRET_KEY=

# Webhook の署名シークレット（whsec_...）。
# Dashboard → 開発者 → Webhook → エンドポイントを追加
#   URL: https://hisrecoveries.com/api/stripe/webhook
#   イベント: checkout.session.completed / checkout.session.expired
#             charge.refunded / charge.dispute.created
# これが未設定だと Webhook は 503 を返し、入金が記録されない。
STRIPE_WEBHOOK_SECRET=

# 価格ID（任意）。設定するとその Price を使い、未設定なら
# src/lib/pricing.ts の金額で都度 price_data を組む。
# 本番では Price を作って ID を入れるほうが、金額の履歴が Stripe 側に残る。
STRIPE_PRICE_FOUNDER=
STRIPE_PRICE_STANDARD=
