# === Threads API（@hisrecoveries_jp アカウント / account_id=mens-body-lab） ===
# Meta開発者ポータルで作成したアプリに Threads API を追加し、
# hisrecoveries の Threads アカウントを接続 → 長命トークンを発行してここに設定。
# 必要スコープ: threads_basic, threads_content_publish（投稿）, threads_manage_insights（分析）
THREADS_APP_ID=your_app_id
THREADS_APP_SECRET=your_app_secret
THREADS_ACCESS_TOKEN=your_long_lived_access_token
THREADS_USER_ID=your_threads_user_id

# === AI API（投稿生成用: Gemini無料枠で¥0運用。mock運用なら不要） ===
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash

# === 管理ページ(admin) ローカル起動用（Vercelでは Vercel の環境変数に設定） ===
# ADMIN_USER=hr-marketing
# ADMIN_PASSWORD=your_strong_password
# GITHUB_TOKEN=repo書込権限のPAT
# GITHUB_REPO=Shouta07/threads
# GITHUB_BRANCH=main

# === システム設定 ===
LOG_LEVEL=INFO

# === 任意 ===
# THREADS_KEYWORD_SEARCH_APPROVED=true   # キーワード検索（App Review承認後）
# GOOGLE_SHEETS_ID=...                    # 分析をSheetsにも書く場合
# GOOGLE_SHEETS_CREDENTIALS_JSON=...
